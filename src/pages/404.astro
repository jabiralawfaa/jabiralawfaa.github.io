---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout title={`404 — ${site.meta.title}`} description="Page not found.">
  <section class="min-h-[calc(100vh-65px)] flex flex-col px-6 md:px-10 pt-10 md:pt-12 pb-6 md:pb-8">
    <div class="max-w-editorial mx-auto w-full flex-1 flex flex-col">

      <div class="flex items-start justify-between gap-6 pb-6 md:pb-8 border-b border-ink">
        <div class="flex flex-col gap-1">
          <span class="label">Error — Index 404</span>
          <span class="label text-stone-dark">Volume 01 / Edition I</span>
        </div>
        <div class="flex flex-col gap-1 text-right">
          <span class="label">Indonesia · GMT+7</span>
          <span class="label text-stone-dark">Page not found</span>
        </div>
      </div>

      <div class="flex-1 flex flex-col justify-center py-8 md:py-12">
        <div class="label mb-6 md:mb-10">10 — Error</div>
        <h1 class="font-display font-black text-mega">
          <span class="block">404</span>
          <span class="block italic font-normal text-stone-dark">This index entry</span>
          <span class="block">does not exist.</span>
        </h1>
      </div>

      <div class="grid grid-cols-12 gap-y-8 gap-x-4 pt-6 md:pt-8 border-t border-ink">
        <div class="col-span-12 md:col-span-7">
          <p class="editorial-lead max-w-2xl">
            The page you requested is not in this edition of the portfolio.
            It may have been moved, renamed, or never catalogued at all.
          </p>
        </div>
        <div class="col-span-12 md:col-span-4 md:col-start-9 flex flex-col gap-3 self-end">
          <a href="/" class="group flex items-center justify-between border border-ink px-4 py-3 hover-invert">
            <span class="label-lg">Back to index</span>
            <span class="label hover-arrow transition-transform inline-block">↑</span>
          </a>
          <a href="/#work" class="group flex items-center justify-between border border-ink px-4 py-3 hover-invert">
            <span class="label-lg">Explore work</span>
            <span class="label hover-arrow transition-transform inline-block">→</span>
          </a>
        </div>
      </div>

      <div class="hidden md:flex items-center justify-between mt-6 pt-4 border-t border-stone-mid">
        <span class="label text-stone-dark">Error document</span>
        <span class="label text-stone-dark tabular">ERR / 404</span>
      </div>
    </div>
  </section>
</BaseLayout>
